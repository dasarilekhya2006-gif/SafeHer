# =============================================================================
# SafeHer Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file into version control.
# =============================================================================

# SMS Provider Selection:
# Options: 'twilio', 'fast2sms', 'mock' (for local testing), or leave empty to disable
SMS_PROVIDER=

# -----------------------------------------------------------------------------
# OPTION 1: Twilio (Best for International SMS + Automated Emergency Voice Calls)
# Sign up at https://www.twilio.com (Console Dashboard)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# -----------------------------------------------------------------------------
# OPTION 2: Fast2SMS (Best & Simplest for Indian mobile numbers +91)
# Sign up at https://www.fast2sms.com -> Dev API
# -----------------------------------------------------------------------------
FAST2SMS_API_KEY=

# -----------------------------------------------------------------------------
# OPTION 3: Mock Mode (Free testing without sending real messages)
# Set SMS_PROVIDER=mock to simulate real delivery and test the entire SOS flow.
# -----------------------------------------------------------------------------

